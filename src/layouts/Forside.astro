---
// Astro Component Frontmatter (importer layout eller andre komponenter her om du vil)
---

<!-- Hero Section -->
<section class="hero">
    <div class="hero-content">
        <!-- Small Text Above the Main Heading -->
        <p class="eyebrow">TORPTECH / ELEVDREVET IT-ORGANISASJON</p>

        <!-- Main Heading -->
        <h1>
            Reelle oppdrag. Praktisk læring.
            <span>IT som skaper verdi.</span>
        </h1>

        <!-- Description Text -->
        <p class="description">
            En elevdrevet IT-organisasjon der elever skaper
            løsninger og tjenester for mennesker med virkelige behov.
        </p>

        <!-- Call to Action Buttons -->
        <div class="buttons">
            <a href="#kontakt" class="btn-primary">Send forespørsel</a>
            <a href="#tjenester" class="btn-secondary">Se tjenestene</a>
        </div>
    </div>
</section>

<!-- Services Section ("Tre mål / Tre tjenester") -->
<section class="services-section" id="tjenester">
    <div class="services-container">
        <!-- Section Header -->
        <p class="section-eyebrow">DETTE KAN VI BIDRA MED</p>
        <h2 class="section-title">Tre tjenester, ett mål.</h2>

        <!-- Cards Grid -->
        <div class="services-grid">
            <!-- Card 1 -->
            <div class="service-card">
                <span class="card-eyebrow">TJENESTE / 01</span>
                <h3>Brukerstøtte og opplæring</h3>
                <p>Vi hjelper mennesker med teknologi i hverdagen.</p>
                <a href="#les-mer-1" class="card-link">Les mer &rarr;</a>
            </div>

            <!-- Card 2 -->
            <div class="service-card">
                <span class="card-eyebrow">TJENESTE / 02</span>
                <h3>Systemutvikling</h3>
                <p>Vi lager digitale løsninger som løser konkrete behov.</p>
                <a href="#les-mer-2" class="card-link">Les mer &rarr;</a>
            </div>

            <!-- Card 3 -->
            <div class="service-card">
                <span class="card-eyebrow">TJENESTE / 03</span>
                <h3>IT-drift og infrastruktur</h3>
                <p>Vi sørger for at tekniske løsninger kan fungere over tid.</p>
                <a href="#les-mer-3" class="card-link">Les mer &rarr;</a>
            </div>
        </div>

        <!-- Banner Box -->
        <div class="target-banner">
            <div class="banner-text">
                <h3>Hvem er tilbudet for?</h3>
                <p>Elever og ansatte ved skolen, skoleprosjekter, organisasjoner og andre eksterne brukere og oppdragsgivere.</p>
            </div>
            <a href="#kontakt" class="btn-banner">Ta kontakt</a>
        </div>
    </div>
</section>

<style>
    /* ----------------------------------------- */
    /* Global / Reset                             */
    /* ----------------------------------------- */
    * {
        box-sizing: border-box;
    }

    /* ----------------------------------------- */
    /* Hero Section Styling                      */
    /* ----------------------------------------- */
    .hero {
        background: #102638;
        color: white;
        padding: 64px 6.3%;
        min-height: 310px;
        display: flex;
        align-items: center;
    }

    .hero-content {
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
    }

    .eyebrow {
        color: #00c4b0;
        font-size: 11px;
        font-weight: bold;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .hero h1 {
        font-size: clamp(32px, 4vw, 40px);
        line-height: 1.08;
        margin: 12px 0;
    }

    .hero h1 span {
        display: block;
        color: #00c4b0;
    }

    .description {
        color: #c0ccd6;
        font-size: 14px;
        line-height: 1.6;
        max-width: 500px;
    }

    .buttons {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }

    .buttons a {
        padding: 10px 16px;
        border-radius: 5px;
        text-decoration: none;
        font-size: 12px;
        font-weight: bold;
    }

    .btn-primary {
        background: #078c83;
        color: white;
        transition: background-color 0.2s ease;
    }

    .btn-primary:hover {
        background: #056b64;
    }

    .btn-secondary {
        border: 1px solid #526779;
        color: white;
        transition: border-color 0.2s ease;
    }

    .btn-secondary:hover {
        border-color: #00c4b0;
    }

    /* ----------------------------------------- */
    /* Services Section Styling                  */
    /* ----------------------------------------- */
    .services-section {
        background-color: #f4f7f9;
        padding: 64px 6.3%;
        color: #102638;
    }

    .services-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .section-eyebrow {
        color: #00c4b0;
        font-size: 11px;
        font-weight: bold;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .section-title {
        font-size: 28px;
        font-weight: 700;
        margin-top: 0;
        margin-bottom: 32px;
        color: #102638;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .service-card {
        background: #ffffff;
        padding: 24px 20px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        display: flex;
        flex-direction: column;
    }

    .card-eyebrow {
        color: #7b8e9d;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .service-card h3 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 8px 0;
        color: #102638;
    }

    .service-card p {
        font-size: 13px;
        color: #526779;
        line-height: 1.5;
        margin: 0 0 16px 0;
        flex-grow: 1;
    }

    .card-link {
        color: #00c4b0;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .card-link:hover {
        color: #078c83;
    }

    .target-banner {
        background-color: #e6f7f5;
        border-radius: 8px;
        padding: 24px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .banner-text h3 {
        font-size: 15px;
        font-weight: 700;
        margin: 0 0 6px 0;
        color: #102638;
    }

    .banner-text p {
        font-size: 12px;
        color: #526779;
        margin: 0;
        line-height: 1.5;
        max-width: 550px;
    }

    .btn-banner {
        background-color: #078c83;
        color: #ffffff;
        padding: 10px 18px;
        border-radius: 5px;
        text-decoration: none;
        font-size: 12px;
        font-weight: bold;
        white-space: nowrap;
        transition: background-color 0.2s ease;
    }

    .btn-banner:hover {
        background-color: #056b64;
    }

    @media (max-width: 650px) {
        .target-banner {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>