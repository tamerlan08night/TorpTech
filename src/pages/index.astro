import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Forside from '../layouts/Forside.astro';




---

<html lang="no">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>TorpTech</title>
</head>
<body>

<Nav />

<!-- Green Divider -->
    <div style="height: 5px; width: 100%; background-color: #00c4b0;"></div>

<main>
    <Forside />
</main>


<!-- Footer component import -->
<Footer />


</body>
</html>

<style>
	/* Remove default web brauser lines */
	body {
		margin: 0;
		padding: 0;
		background-color: #0d1f2d; /* dark background */
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
	}
</style>