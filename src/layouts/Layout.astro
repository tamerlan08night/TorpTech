---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../Styles/global.css';

interface Props {
	title?: string;
}

const { title = "TorpTech" } = Astro.props;
---

<!doctype html>
<html lang="no" class="scroll-smooth">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title}</title>
</head>
<body class="bg-[#F5F7F8] text-[#1F2937] flex flex-col min-h-screen font-sans antialiased">
<Nav />
<main class="flex-grow">
	<slot />
</main>
<Footer />
</body>
</html>