---
// src/components/Nav.astro
---

<header class="site-header">
    <nav class="navbar">
        <!-- Brand / Logo -->
        <a href="/" class="logo">
            <div class="logo-icon">TT</div>
            <span class="logo-text">TorpTech</span>
        </a>

        <!-- Navigation Links -->
        <ul class="nav-links">
            <li><a href="/" class="active">Forside</a></li>
            <li><a href="/maal">Våre mål</a></li>
            <li><a href="#tjenester">Våre tjenester</a></li>
            <li><a href="#om-oss">Om oss</a></li>
        </ul>

        <!-- Call to Action Button -->
        <div class="nav-cta">
            <a href="#kontakt" class="btn-cta">Send forespørsel</a>
        </div>
    </nav>
</header>

<style>
    /* Header Container */
    .site-header {
        width: 100%;
        background-color: #ffffff;
        border-bottom: 1px solid #e5e7eb;
    }

    /* Navbar Layout */
    .navbar {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Logo Styling */
    .logo {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
    }

    .logo-icon {
        background-color: #0b253a;
        color: #10b981;
        font-weight: 700;
        font-size: 0.875rem;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .logo-text {
        color: #0b253a;
        font-weight: 700;
        font-size: 1.25rem;
    }

    /* Navigation Links */
    .nav-links {
        display: flex;
        list-style: none;
        gap: 2rem;
        align-items: center;
        margin: 0;
        padding: 0;
    }

    .nav-links a {
        text-decoration: none;
        color: #4b5563;
        font-size: 0.95rem;
        font-weight: 600;
        transition: color 0.2s ease;
    }

    .nav-links a:hover {
        color: #0b253a;
    }

    /* Active Link Styling */
    .nav-links a.active {
        color: #0d9488;
    }

    /* CTA Button Styling */
    .btn-cta {
        display: inline-block;
        background-color: #0d8a80;
        color: #ffffff;
        padding: 0.6rem 1.25rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        transition: background-color 0.2s ease;
    }

    .btn-cta:hover {
        background-color: #0b7068;
    }
</style>